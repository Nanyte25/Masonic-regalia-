---
interface Props { verb?: string }
const { verb = "Continue" } = Astro.props;
---
<div class="social" data-verb={verb} hidden>
  <a class="btn ghost social-btn" data-provider="google" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.5 12.3c0-.8-.1-1.5-.2-2.3H12v4.3h5.9a5 5 0 0 1-2.2 3.3v2.7h3.5c2.1-1.9 3.3-4.7 3.3-8z"/><path fill="#34A853" d="M12 23c3 0 5.5-1 7.3-2.7l-3.5-2.7c-1 .7-2.3 1.1-3.8 1.1-2.9 0-5.4-2-6.3-4.6H2.1v2.8A11 11 0 0 0 12 23z"/><path fill="#FBBC05" d="M5.7 14.1a6.6 6.6 0 0 1 0-4.2V7.1H2.1a11 11 0 0 0 0 9.8z"/><path fill="#EA4335" d="M12 5.4c1.6 0 3.1.6 4.2 1.7l3.1-3.1A11 11 0 0 0 2.1 7.1l3.6 2.8C6.6 7.3 9.1 5.4 12 5.4z"/></svg>
    <span>{verb} with Google</span>
  </a>
  <a class="btn ghost social-btn" data-provider="facebook" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#1877F2" d="M24 12a12 12 0 1 0-13.9 11.9v-8.4h-3V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v3h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"/></svg>
    <span>{verb} with Facebook</span>
  </a>
  <p class="small muted">Use Facebook if you sign in to Instagram with your Meta account.</p>
  <p class="divider"><span>or use your email</span></p>
</div>
<script>
  import { api, API_URL, BASE } from "../lib/api";
  const box = document.querySelector<HTMLElement>(".social")!;
  const next = new URLSearchParams(location.search).get("next");
  const returnTo = new URL(BASE + (next === "basket" ? "basket/" : "account/"), location.origin).toString();
  api<{ providers: string[] }>("/auth/providers")
    .then(({ providers }) => {
      if (!providers.length) return;
      box.hidden = false;
      for (const p of providers) {
        const a = box.querySelector<HTMLAnchorElement>(`[data-provider="${p}"]`);
        if (!a) continue;
        a.hidden = false;
        a.href = `${API_URL}/auth/oauth/${p}/start?return_to=${encodeURIComponent(returnTo)}`;
      }
    })
    .catch(() => {});
</script>
<style>
  .social { margin-bottom: 1rem; }
  .social[hidden], .social-btn[hidden] { display: none; }
  .social-btn { width: 100%; margin-bottom: .6rem; background: var(--white); }
  .social-btn svg { width: 20px; height: 20px; }
  .divider { display: flex; align-items: center; gap: .75rem; color: var(--muted); font-size: var(--t-sm); margin: 1.25rem 0; }
  .divider::before, .divider::after { content: ""; flex: 1; border-top: 1px solid var(--line); }
</style>
