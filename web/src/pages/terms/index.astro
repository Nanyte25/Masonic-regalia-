---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../site";
---
<Base title="Terms of sale">
  <section class="section wrap prose">
    <h1>Terms of sale</h1>
    <p class="notice">Template for review. Have it checked by a solicitor before you launch.</p>
    <ol>
      <li>These terms apply to orders placed with {SITE.name}, {SITE.address}.</li>
      <li>Prices are in euro and include Irish VAT for delivery in the EU. Prices for delivery outside the EU exclude VAT. Prices shown in other currencies are converted at our published rate.</li>
      <li>A contract is formed when we email confirmation of your paid order.</li>
      <li>You are responsible for confirming that regalia matches the requirements of your constitution, order and rank.</li>
      <li>Personalised and made-to-order goods are excluded from the right to cancel, except where faulty.</li>
      <li>Your statutory rights under Irish and EU consumer law are not affected.</li>
    </ol>
  </section>
</Base>
