---
import Base from "../../../layouts/Base.astro";
import SocialButtons from "../../../components/SocialButtons.astro";
import "../../../styles/auth.css";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Base title="Create an account">
  <div class="auth">
    <h1>Create an account</h1>
    <p class="muted">Track orders, save your lodge details for embroidery, and keep a list of items for later.</p>
    <p id="msg" class="notice error" role="alert"></p>
    <SocialButtons verb="Sign up" />
    <form id="f" novalidate>
      <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" required /></div>
      <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
      <div class="field"><label for="password">Password</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required /><p class="hint">At least 10 characters.</p></div>
      <label class="check field"><input type="checkbox" name="marketing" /><span>Email me about new regalia and offers. You can stop these at any time.</span></label>
      <label class="check field"><input type="checkbox" name="terms" required /><span>I agree to the <a href={`${base}terms/`}>terms of sale</a> and <a href={`${base}privacy/`}>privacy notice</a>.</span></label>
      <button class="btn block" type="submit">Create account</button>
    </form>
    <p class="alt">Already registered? <a href={`${base}account/signin/`}>Sign in</a></p>
  </div>
  <script>
    import { api, showMessage, url } from "../../../lib/api";
    import { setToken } from "../../../lib/store";
    const msg = document.getElementById("msg");
    const f = document.getElementById("f") as HTMLFormElement;
    const next = new URLSearchParams(location.search).get("next");
    f.addEventListener("submit", async (e) => {
      e.preventDefault();
      const d = new FormData(f);
      if (!d.get("terms")) return showMessage(msg, "Tick the box to agree to the terms before creating an account.");
      if (String(d.get("password")).length < 10) return showMessage(msg, "Use a password of at least 10 characters.");
      try {
        const r = await api<{ token: string }>("/auth/register", {
          method: "POST",
          json: { name: d.get("name"), email: d.get("email"), password: d.get("password"), marketing: !!d.get("marketing") },
        });
        setToken(r.token);
        location.href = url(next === "basket" ? "basket/" : "account/?welcome=1");
      } catch (x) {
        showMessage(msg, (x as Error).message);
      }
    });
  </script>
</Base>
