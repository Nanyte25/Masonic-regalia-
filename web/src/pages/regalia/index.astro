---
import Base from "../../layouts/Base.astro";
import Catalogue from "../../components/Catalogue.astro";
import { PRODUCTS, BODIES } from "../../../../shared/catalog";
const items = PRODUCTS.filter((p) => ["apron", "collar", "jewel", "gauntlets", "set", "case", "gloves"].includes(p.kind));
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<Base title="Regalia by order" description="Irish, English and Scottish regalia for Craft, Royal Arch, Knight Masons, Prince Masons and Preceptory.">
  <section class="section wrap">
    <h1>Regalia</h1>
    <p class="muted">Filter by constitution, order and rank. Each colour band marks the order an item belongs to.</p>
    <nav class="order-links" aria-label="Orders">
      {Object.entries(BODIES).filter(([k]) => k !== "general").map(([k, b]) => (
        <a href={`${base}regalia/${k}/`} class="order-mark" style={`--mark:${b.colour};--mark-trim:${b.trim}`}>{b.label}</a>
      ))}
    </nav>
    <Catalogue products={items} />
  </section>
</Base>
<style>
  .order-links { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin: 0 0 2rem; }
  .order-links a { color: var(--ink); font-size: var(--t-base); font-weight: 500; }
</style>
